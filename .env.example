# ---- Fuente 1: Kommo CRM -------------------------------------------------
# Subdominio de tu cuenta: https://<KOMMO_SUBDOMAIN>.kommo.com
KOMMO_SUBDOMAIN=
# Token de larga duración (Kommo > Ajustes > Integraciones > integración privada > "Keys and scopes" > Generate long-lived token)
KOMMO_ACCESS_TOKEN=
# Dominio base (kommo.com por default; cambiar solo si tu cuenta vive en otro dominio)
KOMMO_BASE_DOMAIN=kommo.com
# Avanzado: URL base completa (sustituye subdominio + dominio). Útil para pruebas.
# KOMMO_BASE_URL=https://tuempresa.kommo.com
# Solo se traen leads con actividad en los últimos N días (menos peticiones a la API)
KOMMO_LOOKBACK_DAYS=180

# ---- Dashboard -----------------------------------------------------------
# Segundos que se cachea el snapshot del CRM antes de volver a consultarlo
CACHE_TTL_SECONDS=300
# Días sin movimiento para marcar un lead abierto como "sin atención"
DASHBOARD_STALE_DAYS=3
# Zona horaria para mostrar fechas
DASHBOARD_TZ=America/Monterrey
# Si se define, el dashboard pide usuario/contraseña (Basic Auth). Recomendado en Railway.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
