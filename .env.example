# Copia a .env para correr local. NUNCA commitear el .env real.
META_TOKEN=
META_AD_ACCOUNT=771839424126319
META_API_VERSION=v21.0

# Credenciales de acceso al dashboard
DASH_USER=
DASH_PASS=

# CRM: uno de los dos. Sin ninguno, el bloque de CRM queda en el ultimo corte manual.
HUBSPOT_TOKEN=
KOMMO_SUBDOMAIN=
KOMMO_LONG_TOKEN=

REFRESH_HOURS=6

# CPL maximo que aguanta el unit economics, en MXN. 0 = regla apagada.
# Es el limite absoluto de la regla de pausa: un anuncio con >=8 resultados que
# lo pase entra a revision. Se calcula como ticket x margen x conversion
# lead->venta. Ver el bloque "Regla de pausa" del CLAUDE.md.
META_CPL_FORM=0
META_CPL_WA=0

# Botón de pausa del dashboard. Sin PAUSA_ACTIVA=1 el endpoint existe pero se
# niega a escribir: es el kill-switch, se quita en Railway sin redesplegar.
PAUSA_ACTIVA=
# Anuncios que se pueden pausar de un jalon desde la pagina.
PAUSA_MAX_POR_LOTE=5

# Dashboard de ventas (/ventas). Meta mensual de venta EN PESOS para todos los
# asesores (default 800000) y, si alguien tiene otra, JSON por asesor con llave
# nombre-apellido sin acentos, ej. {"marco-perez": 1000000}. Ningún CRM las guarda.
VENTAS_META_MXN=800000
VENTAS_METAS=
# Pipeline sano (regla de Alejandro): cotizado con <= VENTAS_COTIZADO_DIAS días
# por VENTAS_COTIZADO_X veces la meta mensual.
VENTAS_COTIZADO_X=10
VENTAS_COTIZADO_DIAS=90
# Portal de HubSpot para los links de los deals (default 24082518).
HUBSPOT_PORTAL=24082518
# Días de historia del corte de ventas (default 90).
VENTAS_DIAS=90

# Qué corre este proceso: marketing (solo Meta + CRM de marketing), ventas (solo
# el corte de ventas, / redirige a /ventas/) o ambos (default, para local).
DASH_MODO=ambos
# 1 = /ventas no pide basic auth; la puerta es la sesión por usuario/contraseña de la
# propia página (data/ventas_usuarios.json; DASH_USER/PASS entran como administrador).
# La portada de marketing y /estado /cola /pausar siguen con basic auth.
VENTAS_PUBLICO=
# Firma de la cookie de sesión de /ventas. Opcional: sin ella se genera un secreto una
# sola vez en DASH_DATA/ventas_secret.txt (el volumen).
VENTAS_SECRET=

# Ventas reales desde la app de comisiones (Supabase, solo lectura). Sin estas dos el corte
# no las trae. VENTAS_COMISIONES_MAP fuerza el cruce vendedor -> slug del CRM cuando el
# primer nombre no alcanza: {"Arely Y david": "arely-tovar"}
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
VENTAS_COMISIONES_MAP=

# Quitar de la asignación desde /ventas (Kommo): la MISMA URL y token del servicio Kommo-ia
# (Apps Script de la pestaña «Sanciones 24h» del Sheet «Dashboard Leads Kenet»).
SANCIONES_SHEET_URL=
SANCIONES_SHEET_TOKEN=kenet-sanciones-2026
