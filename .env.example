# Copia a .env para correr local. NUNCA commitear el .env real.
META_TOKEN=
META_AD_ACCOUNT=771839424126319
META_API_VERSION=v21.0

# Credenciales de acceso al dashboard
DASH_USER=
DASH_PASS=

# CRM: uno de los dos. Sin ninguno, el bloque de CRM queda en el ultimo corte manual.
HUBSPOT_TOKEN=
KOMMO_SUBDOMAIN=
KOMMO_LONG_TOKEN=

REFRESH_HOURS=6

# CPL maximo que aguanta el unit economics, en MXN. 0 = regla apagada.
# Es el limite absoluto de la regla de pausa: un anuncio con >=8 resultados que
# lo pase entra a revision. Se calcula como ticket x margen x conversion
# lead->venta. Ver el bloque "Regla de pausa" del CLAUDE.md.
META_CPL_FORM=0
META_CPL_WA=0

# Botón de pausa del dashboard. Sin PAUSA_ACTIVA=1 el endpoint existe pero se
# niega a escribir: es el kill-switch, se quita en Railway sin redesplegar.
PAUSA_ACTIVA=
# Anuncios que se pueden pausar de un jalon desde la pagina.
PAUSA_MAX_POR_LOTE=5

# Dashboard de ventas (/ventas). Metas mensuales de ventas por asesor, JSON con
# llave = nombre-apellido sin acentos, ej. {"marco-perez": 70, "mara-galvez": 30}.
# Ningún CRM las guarda; sin esto la página dice «sin meta».
VENTAS_METAS=
# Portal de HubSpot para los links de los deals (default 24082518).
HUBSPOT_PORTAL=24082518
# Días de historia del corte de ventas (default 90).
VENTAS_DIAS=90

# Qué corre este proceso: marketing (solo Meta + CRM de marketing), ventas (solo
# el corte de ventas, / redirige a /ventas/) o ambos (default, para local).
DASH_MODO=ambos
