# ---- Kommo CRM (mismas variables que Kommo-ia y mkt-dashboard) -----------
# Subdominio de la cuenta: https://<KOMMO_SUBDOMAIN>.kommo.com
KOMMO_SUBDOMAIN=samuelkenetsolarcom
# Token de larga duración de la integración privada. En Railway, dentro del mismo
# proyecto, se hereda sin copiarlo: KOMMO_LONG_TOKEN=${{kommo-salesbot-ia.KOMMO_LONG_TOKEN}}
KOMMO_LONG_TOKEN=
# Ventana que se sincroniza completa (leads creados, cerrados o tocados en N días)
KOMMO_LOOKBACK_DAYS=120
# Solo estos pipelines (ids separados por coma). Vacío = todos los no archivados.
# Ej. Ventas, Cadencia, Hunting y Leads Nuevos: 14175132,14157248,14213728,12753132
KOMMO_PIPELINES=
# Avanzado: URL base completa (sustituye subdominio). Útil para pruebas.
# KOMMO_BASE_URL=https://tuempresa.kommo.com

# ---- Sincronía -----------------------------------------------------------
# Incremental (solo lo que cambió) cada N minutos
SYNC_INTERVAL_MIN=10
# Corte completo cada N horas (mismo ritmo que mkt-dashboard y el Sheet)
REFRESH_HOURS=6
# Secreto del webhook de Kommo: la URL del webhook lleva ?key=<secreto>
KOMMO_WEBHOOK_SECRET=
# Apaga el programador (CI / pruebas)
# SYNC_DISABLED=1

# ---- Persistencia --------------------------------------------------------
# Opción A: volumen de Railway montado en /data (igual que mkt-dashboard)
DASH_DATA=./data
# Opción B: Postgres (Railway Postgres o Supabase). Si existe, manda sobre el volumen
# y deja las tablas crm_* listas para mesa de ayuda / comisiones / reportes.
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# ---- Dashboard -----------------------------------------------------------
# Días sin movimiento para marcar un lead abierto como "sin atención"
DASHBOARD_STALE_DAYS=3
# Zona horaria para mostrar fechas
DASHBOARD_TZ=America/Monterrey
# Usuario y contraseña (Basic Auth). Recomendado en Railway; sin DASH_PASS no pide nada.
DASH_USER=admin
DASH_PASS=
